{
  "name": "photoshoot",
  "version": "1.0.1",
  "description": "Photoshoot — a modern Windows photobooth app. Clean-room homage, all original code and assets.",
  "author": "Photoshoot",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build:app": "node esbuild.mjs",
    "build:app:prod": "node esbuild.mjs --prod",
    "dev": "node esbuild.mjs && electron .",
    "watch": "node esbuild.mjs --watch",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.mjs --prod && electron-builder",
    "build:win": "node esbuild.mjs --prod && electron-builder --win",
    "build:dir": "node esbuild.mjs --prod && electron-builder --dir",
    "build:web": "node web/build-web.mjs",
    "test:filters": "esbuild build/filter-schema.test.mjs --bundle --platform=node --format=esm --outfile=build/.filter-test.mjs --log-level=warning && node build/.filter-test.mjs",
    "deploy": "node web/build-web.mjs && firebase deploy --only hosting",
    "test:camera": "esbuild build/camera.test.mjs --bundle --platform=node --format=esm --outfile=build/.camera-test.mjs --log-level=warning && node --test build/.camera-test.mjs",
    "test": "npm run test:filters && npm run test:camera",
    "test:e2e": "playwright test",
    "web:dev": "npm run build:web && node web/serve.mjs",
    "verify": "npm run typecheck && npm test && npm run build:app:prod && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.7.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18"
  },
  "engines": {
    "node": ">=22"
  }
}
